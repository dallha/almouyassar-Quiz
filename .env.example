# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Neon Postgres: utiliser DATABASE_URL côté serveur et ne jamais l'exposer avec VITE_.
DATABASE_URL="postgresql://user:password@ep-example.neon.tech/db?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-example.neon.tech/db?sslmode=require"

# NEON_AUTH: URL publique de Neon Auth pour le client React.
VITE_NEON_AUTH_URL="https://your-neon-auth-url"

# UPSTASH REDIS: Utilisé pour le Rate Limiting (Anti-abus)
# Créez une base de données Redis gratuite sur https://console.upstash.com
UPSTASH_REDIS_REST_URL="https://your-upstash-redis-url"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"
